     */
    public function create(): View
    {
        ${{modelNameSingularSnakeLowerCase}} = new {{modelName}}();

        return view('{{modelViewFolder}}.{{modelView}}.create', compact('{{modelNameSingularSnakeLowerCase}}'));
    }

