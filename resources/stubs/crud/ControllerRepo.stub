     */
    function __construct({{modelName}}Interface ${{modelNameLowerCase}})
    {
        $this->{{modelNameLowerCase}} = ${{modelNameLowerCase}};

        $this->middleware('permission:{{modelRoute}}-list',  ['only' => ['index']]);
        $this->middleware('permission:{{modelRoute}}-view',  ['only' => ['show']]);
        $this->middleware('permission:{{modelRoute}}-create',['only' => ['create','store']]);
        $this->middleware('permission:{{modelRoute}}-edit',  ['only' => ['edit','update']]);
        $this->middleware('permission:{{modelRoute}}-delete',['only' => ['destroy']]);
    }

    /**
     * Display a listing of the resource.
     */
    public function index(Request $request): View
    {
        $pagination_mode = $request->input('pagination_mode','client');
        if($pagination_mode == 'client'){
            ${{modelNamePluralSnakeLowerCase}} = $this->{{modelNameLowerCase}}->all();
            return view('{{modelViewFolder}}.{{modelView}}.index', compact('{{modelNamePluralSnakeLowerCase}}'));
        }
        ${{modelNamePluralSnakeLowerCase}} = $this->{{modelNameLowerCase}}->paginate();

        return view('{{modelViewFolder}}.{{modelView}}.index', compact('{{modelNamePluralSnakeLowerCase}}'))
            ->with('i', ($request->input('page', 1) - 1) * ${{modelNamePluralSnakeLowerCase}}->perPage());
    }

