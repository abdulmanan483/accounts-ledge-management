     * Store a newly created resource in storage.
     */
    public function store({{modelName}}Request $request): RedirectResponse
    {
        $this->{{modelNameLowerCase}}->create($request->validated());

        return Redirect::route('{{modelRoute}}.index')
            ->with('success', '{{modelName}} created successfully.');
    }

    /**
     * Display the specified resource.
     */
    public function show($id): View
    {
        ${{modelNameSingularSnakeLowerCase}} = $this->{{modelNameLowerCase}}->find($id);

        return view('{{modelViewFolder}}.{{modelView}}.show', compact('{{modelNameSingularSnakeLowerCase}}'));
    }

    /**
     * Show the form for editing the specified resource.
     */
    public function edit($id): View
    {
        ${{modelNameSingularSnakeLowerCase}} = $this->{{modelNameLowerCase}}->find($id);

        return view('{{modelViewFolder}}.{{modelView}}.edit', compact('{{modelNameSingularSnakeLowerCase}}'));
    }

    /**
     * Update the specified resource in storage.
     */
    public function update({{modelName}}Request $request, {{modelName}} ${{modelNameSingularSnakeLowerCase}}): RedirectResponse
    {
        $this->{{modelNameLowerCase}}->update(${{modelNameSingularSnakeLowerCase}}, $request->validated());

        return Redirect::route('{{modelRoute}}.index')
            ->with('success', '{{modelName}} updated successfully');
    }

    public function destroy($id): RedirectResponse
    {
        $this->{{modelNameLowerCase}}->delete($id);

        return Redirect::route('{{modelRoute}}.index')
            ->with('success', '{{modelName}} deleted successfully');
